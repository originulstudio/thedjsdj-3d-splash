---
import Base from "@/layouts/Base.astro";
import Header from "@/components/chrome/Header.astro";
import MenuOverlay from "@/components/chrome/MenuOverlay.astro";
import ProgressIndicator from "@/components/chrome/ProgressIndicator.astro";
import CTACluster from "@/components/experience/CTACluster.astro";
import SceneFallback from "@/components/experience/SceneFallback.astro";
import { artist } from "@/config/artist";
---
<Base>
  <div class="grain" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <canvas id="stage" aria-hidden="true"></canvas>
  <SceneFallback />
  <Header />
  <ProgressIndicator />
  <p class="chrome chrome-br hint" data-hint>MOVE THROUGH THE FIELD</p>
  <MenuOverlay />
  <div id="loader" role="status" aria-live="polite">
    <p>TUNING THE VOID</p>
    <div class="loader-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="5">
      <span data-loader-bar></span>
    </div>
    <p class="meta">SIGNAL ACQUIRING</p>
  </div>
  <main data-experience>
    <section class="chapter chapter-hero" id="signal">
      <div class="copy copy-center">
        <h1 class="identity">
          <img src={artist.wordmark} alt="THE DJ$ DJ" />
        </h1>
        <p class="kicker">VIP ACCESS GRANTED</p>
        <p class="line">VIP HUMBLE // THE ARTIST$ ARTIST</p>
        <a class="enter" href="#orbit">ENTER ORBIT</a>
      </div>
      <img class="sr-only" src={artist.portrait} alt="THE DJ$ DJ in profile, wearing headphones, facing the light." />
    </section>
    <section class="chapter chapter-orbit" id="orbit">
      <div class="copy copy-left">
        <p class="kicker">FREQUENCY: UNKNOWN</p>
        <p class="line">SOUND HAS A GRAVITATIONAL FIELD.</p>
      </div>
    </section>
    <section class="chapter chapter-figure" id="figure">
      <div class="copy copy-left">
        <p class="kicker">THE TRUTH LIES IN THE FREQUENCY</p>
        <div class="actions">
          <a href="#listen">LISTEN</a>
          <a href="#watch">WATCH</a>
        </div>
      </div>
    </section>
    <CTACluster />
  </main>
</Base>
<script>
  import { boot } from "@/lib/boot";
  boot();
</script>
---
